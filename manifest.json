{
    "manifest_version": 3,
    "name": "Universal Adblocker",
    "version": "1.0",
    "description": "Remove ads from any website",
    "permissions": [
        "scripting"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ],
            "css": [
                "content.css"
            ],
            "run_at": "document_start"
        }
    ]
}