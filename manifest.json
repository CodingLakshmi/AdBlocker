{
    "manifest_version": 3,
    "name": "Youtube Adblocker",
    "version": "1.0",
    "description": "Remove ads from Youtube",
    "permissions": [
        "scripting"
    ],
    "host_permissions": [
        "*://www.youtube.com/*",
        "*://youtube.com/*",
        "*://m.youtube.com/*"
    ],
    "content_scripts": [
        {
            "matches": [
                "*://www.youtube.com/*",
                "*://youtube.com/*",
                "*://m.youtube.com/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_start"
        }
    ]
}